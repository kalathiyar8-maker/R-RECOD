<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/rk_ink"
            android:textSize="26sp" android:textStyle="bold" android:letterSpacing="0.02"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:layout_marginBottom="24dp"
            android:text="@string/tagline" android:textColor="@color/rk_dim" android:textSize="13sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/quality" android:textColor="@color/rk_dim"
            android:textAllCaps="true" android:textSize="12sp" android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <RadioGroup android:id="@+id/qualityGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <RadioButton android:id="@+id/q480" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="480p"
                android:textColor="@color/rk_ink" android:layout_marginEnd="16dp"/>
            <RadioButton android:id="@+id/q720" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="720p"
                android:textColor="@color/rk_ink" android:layout_marginEnd="16dp"/>
            <RadioButton android:id="@+id/q1080" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="1080p HD"
                android:textColor="@color/rk_ink" android:checked="true"/>
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/framerate" android:textColor="@color/rk_dim"
                    android:textAllCaps="true" android:textSize="12sp" android:letterSpacing="0.1"/>
                <Spinner android:id="@+id/fpsSpinner" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:entries="@array/fps_entries"
                    android:popupBackground="@color/rk_panel"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/bitrate" android:textColor="@color/rk_dim"
                    android:textAllCaps="true" android:textSize="12sp" android:letterSpacing="0.1"/>
                <Spinner android:id="@+id/bitrateSpinner" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:entries="@array/bitrate_entries"
                    android:popupBackground="@color/rk_panel"/>
            </LinearLayout>
        </LinearLayout>

        <Switch android:id="@+id/internalSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/internal"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="true" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/micSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/mic"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="true" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/cleanSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/clean"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="true" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/drawSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/draw_overlay"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="false" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/countdownSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/countdown"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="true" android:paddingVertical="8dp"/>

        <Switch android:id="@+id/floatingSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/floating"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:checked="true" android:paddingVertical="8dp"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/startBtn" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/start"
            android:textColor="#FFFFFF" android:textSize="16sp"
            android:backgroundTint="@color/rk_red" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/stopBtn" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="@string/stop"
            android:textColor="@color/rk_ink" android:textSize="16sp"
            android:backgroundTint="@color/rk_panel" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/galleryBtn" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="@string/my_recordings"
            android:textColor="@color/rk_ink" android:textSize="15sp"
            android:backgroundTint="@color/rk_panel"/>

        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/status_idle" android:textColor="@color/rk_dim" android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>
